<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ApplicationEvent.
    -->
    <changeSet id="20261010052910-1" author="jhipster">
        <createTable tableName="application_event">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stage_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="event_type" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column name="previous_value" type="varchar(100)">
                <constraints nullable="true" />
            </column>
            <column name="new_value" type="varchar(100)">
                <constraints nullable="true" />
            </column>
            <column name="actor" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="occurred_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="reason" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="metadata_json" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="application_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="application_event" columnName="occurred_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
