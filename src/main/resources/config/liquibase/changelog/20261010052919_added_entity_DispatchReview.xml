<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity DispatchReview.
    -->
    <changeSet id="20261010052919-1" author="jhipster">
        <createTable tableName="dispatch_review">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="reviewed_at" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="reviewer_username" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="result" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="recommendation" type="varchar(40)">
                <constraints nullable="true" />
            </column>
            <column name="extension_end_date" type="date">
                <constraints nullable="true" />
            </column>
            <column name="final_decision" type="varchar(40)">
                <constraints nullable="true" />
            </column>
            <column name="dispatch_assignment_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="dispatch_review" columnName="reviewed_at" columnDataType="${datetimeType}"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
