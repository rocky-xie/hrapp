<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity PartnerOrganization.
    -->
    <changeSet id="20261010052917-1" author="jhipster">
        <createTable tableName="partner_organization">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="partner_code" type="varchar(40)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_partner_organization__partner_code" />
            </column>
            <column name="name" type="varchar(150)">
                <constraints nullable="false" />
            </column>
            <column name="roles_json" type="${clobType}">
                <constraints nullable="false" />
            </column>
            <column name="dispatch_enabled" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="default_observation_days" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="active" type="boolean">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
