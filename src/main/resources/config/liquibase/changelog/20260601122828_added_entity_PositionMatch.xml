<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity PositionMatch.
    -->
    <changeSet id="20260601122828-1" author="jhipster">
        <createTable tableName="position_match" remarks="人岗匹配。分析某人是否适任某个职位的评估记录。">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="match_score" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="matched_skills" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="gap_skills" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="readiness" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="recommendation" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="analysis_date" type="date">
                <constraints nullable="false" />
            </column>
            <column name="remark" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="person_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="position_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
