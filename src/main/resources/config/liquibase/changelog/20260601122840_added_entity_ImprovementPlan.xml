<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity ImprovementPlan.
    -->
    <changeSet id="20260601122840-1" author="jhipster">
        <createTable tableName="improvement_plan" remarks="改善计划。针对问题制定的改善行动计划。">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="plan_name" type="varchar(150)">
                <constraints nullable="false" />
            </column>
            <column name="plan_status" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="problem_summary" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="improvement_action" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="owner_name" type="varchar(100)">
                <constraints nullable="true" />
            </column>
            <column name="start_date" type="date">
                <constraints nullable="true" />
            </column>
            <column name="target_date" type="date">
                <constraints nullable="true" />
            </column>
            <column name="completion_date" type="date">
                <constraints nullable="true" />
            </column>
            <column name="review_result" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="position_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <column name="skill_id" type="bigint">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
