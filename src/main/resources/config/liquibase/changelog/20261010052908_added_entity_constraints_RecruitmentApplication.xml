<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity RecruitmentApplication.
    -->
    <changeSet id="20261010052908-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="candidate_id"
                                 baseTableName="recruitment_application"
                                 constraintName="fk_recruitment_application__candidate_id"
                                 referencedColumnNames="id"
                                 referencedTableName="external_candidate"
                                 />

        <addForeignKeyConstraint baseColumnNames="requisition_id"
                                 baseTableName="recruitment_application"
                                 constraintName="fk_recruitment_application__requisition_id"
                                 referencedColumnNames="id"
                                 referencedTableName="recruitment_requisition"
                                 />

        <addForeignKeyConstraint baseColumnNames="requisition_version_id"
                                 baseTableName="recruitment_application"
                                 constraintName="fk_recruitment_application__requisition_version_id"
                                 referencedColumnNames="id"
                                 referencedTableName="recruitment_requisition_version"
                                 />
    </changeSet>
</databaseChangeLog>
