<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261010052921-1" author="hrapp">
        <createTable tableName="requisition_edit_event">
            <column name="id" type="bigint"><constraints primaryKey="true" nullable="false" /></column>
            <column name="event_type" type="varchar(20)"><constraints nullable="false" /></column>
            <column name="actor" type="varchar(100)"><constraints nullable="false" /></column>
            <column name="occurred_at" type="${datetimeType}"><constraints nullable="false" /></column>
            <column name="version_number" type="integer"><constraints nullable="false" /></column>
            <column name="reason" type="${clobType}" />
            <column name="requisition_id" type="bigint"><constraints nullable="false" /></column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="requisition_edit_event"
            baseColumnNames="requisition_id"
            referencedTableName="recruitment_requisition"
            referencedColumnNames="id"
            constraintName="fk_requisition_edit_event__requisition_id" />
        <createIndex tableName="requisition_edit_event" indexName="idx_requisition_edit_event__requisition_id">
            <column name="requisition_id" />
        </createIndex>
    </changeSet>
</databaseChangeLog>
