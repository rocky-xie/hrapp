<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Evaluation.
    -->
    <changeSet id="20260601122839-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="person_id"
                                 baseTableName="evaluation"
                                 constraintName="fk_evaluation__person_id"
                                 referencedColumnNames="id"
                                 referencedTableName="person"
                                 />

        <addForeignKeyConstraint baseColumnNames="position_id"
                                 baseTableName="evaluation"
                                 constraintName="fk_evaluation__position_id"
                                 referencedColumnNames="id"
                                 referencedTableName="position"
                                 />

        <addForeignKeyConstraint baseColumnNames="training_goal_id"
                                 baseTableName="evaluation"
                                 constraintName="fk_evaluation__training_goal_id"
                                 referencedColumnNames="id"
                                 referencedTableName="training_goal"
                                 />

        <addForeignKeyConstraint baseColumnNames="evaluator_id"
                                 baseTableName="evaluation"
                                 constraintName="fk_evaluation__evaluator_id"
                                 referencedColumnNames="id"
                                 referencedTableName="person"
                                 />
    </changeSet>
</databaseChangeLog>
