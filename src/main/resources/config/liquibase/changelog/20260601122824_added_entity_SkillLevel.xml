<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity SkillLevel.
    -->
    <changeSet id="20260601122824-1" author="jhipster">
        <createTable tableName="skill_level" remarks="技能等级。统一使用 L0–L4 五级体系。">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_skill_level__code" />
            </column>
            <column name="level_name" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="definition" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="observable_evidence" type="${clobType}">
                <constraints nullable="true" />
            </column>
            <column name="sort_order" type="integer">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->
</databaseChangeLog>
